diff --git a/SConstruct b/SConstruct
index e1e48ffb..2713431b 100644
--- a/SConstruct
+++ b/SConstruct
@@ -109,13 +109,9 @@ env.Append(CCFLAGS='-DNO_LIBCURL')
 # All the emscripten runtime functions we use.
 # Needed since emscripten 1.37.
 extra_exported = [
-    'ALLOC_NORMAL',
     'GL',
     'UTF8ToString',
-    '_free',
-    '_malloc',
     'addFunction',
-    'allocate',
     'ccall',
     'cwrap',
     'getValue',
@@ -142,8 +138,8 @@ flags = [
          '-O3',
          '-s', 'USE_WEBGL2=1',
          '-s', 'NO_EXIT_RUNTIME=1',
-         '-s', '"EXPORTED_FUNCTIONS=[]"',
-         '-s', '"EXTRA_EXPORTED_RUNTIME_METHODS=[%s]"' % extra_exported,
+         '-s', '"EXPORTED_FUNCTIONS=[\'_malloc\',\'_free\']"',
+         '-s', '"EXPORTED_RUNTIME_METHODS=[%s]"' % extra_exported,
          '-s', 'FILESYSTEM=0'
         ]
 
@@ -163,7 +159,7 @@ if env['mode'] == 'debug':
 if env['es6']:
     flags += ['-s', 'EXPORT_ES6=1', '-s', 'USE_ES6_IMPORT_META=0']
 
-env.Append(CCFLAGS=['-DNO_ARGP', '-DGLES2 1'] + flags)
+env.Append(CCFLAGS=['-DNO_ARGP', '-DGLES2 1', '-Wno-unused-command-line-argument', '-Wno-deprecated-non-prototype'])
 env.Append(LINKFLAGS=flags)
 env.Append(LIBS=['GL'])
 
diff --git a/src/designation.c b/src/designation.c
index ad385c56..9cf287a6 100644
--- a/src/designation.c
+++ b/src/designation.c
@@ -427,7 +427,11 @@ void designation_cleanup(const char *dsgn, char *out, int size, int flags)
         }
     }
 
-    snprintf(out, size, "%s", dsgn);
+    // Bare common name (e.g. "Sirius") with no recognized prefix: still
+    // worth trying to translate, for datasets that don't use the "NAME "
+    // convention.
+    snprintf(out, size, "%s",
+             (flags & DSGN_TRANSLATE) ? sys_translate("sky", dsgn) : dsgn);
 }
 
